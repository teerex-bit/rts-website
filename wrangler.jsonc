{
  "name": "rts-website",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-30",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/books/click"],
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "reformingthesoul.com", "custom_domain": true },
    { "pattern": "www.reformingthesoul.com", "custom_domain": true }
  ]
}
